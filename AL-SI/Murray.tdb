$------------------------------------------------------------------------------
$ TYPE DEFINITIONS
$------------------------------------------------------------------------------
TYPE_DEFINITION % SEQ *!
DEFINE_SYSTEM_DEFAULT SPECIE 2 !
DEFAULT_COMMAND DEF_SYS_ELEMENT VA !

$------------------------------------------------------------------------------
$ ELEMENTS
$------------------------------------------------------------------------------
ELEMENT /-   ELECTRON_GAS              0.0000E+00  0.0000E+00  0.0000E+00 !
ELEMENT VA   VACUUM                    0.0000E+00  0.0000E+00  0.0000E+00 !
ELEMENT AL   FCC_A1                    2.6982E+01  4.5773E+03  2.8322E+01 !
ELEMENT SI   DIAMOND_A4                28.0855     3.2175E+03  1.8820E+01 !

$------------------------------------------------------------------------------
$ VV FUNCTIONS
$------------------------------------------------------------------------------
FUNCTION VV0000 298.15 -11030.75; 10000 N !
FUNCTION VV0001 298.15 -1.593; 10000 N !
FUNCTION VV0002 298.15 -4274.5; 10000 N !
FUNCTION VV0003 298.15 3.044; 10000 N !
FUNCTION VV0004 298.15 1006.05; 10000 N !
FUNCTION VV0005 298.15 -0.690; 10000 N !
FUNCTION VV0006 298.15 -200; 10000 N !
FUNCTION VV0007 298.15 -7.594; 10000 N !
FUNCTION VV0008 298.15 89138; 10000 N !
FUNCTION VV0009 298.15 -31.445; 10000 N !
FUNCTION VV0010 298.15 0; 10000 N !
FUNCTION VV0011 298.15 30.0; 10000 N !
FUNCTION VV0012 298.15 50600; 10000 N !
FUNCTION VV0013 298.15 -30.0; 10000 N !
FUNCTION VV0014 298.15 50600; 10000 N !
FUNCTION VV0015 298.15 -17.88; 10000 N !

$------------------------------------------------------------------------------
$ SGTE PURE ELEMENT FUNCTIONS
$------------------------------------------------------------------------------
FUNCTION GHSERAL 298.15 -7976.15+137.093038*T-24.3671976*T*LOG(T)-.001884662*T**2-8.77664E-07*T**3+74092*T**(-1); 700.00 Y
  -11276.24+228.473331*T-38.5844296*T*LOG(T)+.018531982*T**2-5.764227E-06*T**3+74092*T**(-1); 933.47 Y
  -11278.378+188.684153*T-31.748192*T*LOG(T)-1.230524E+28*T**(-9); 2900.00 N !
FUNCTION GFCCAL 298.15 GHSERAL; 2900.00 N !
FUNCTION GLIQAL 298.15 +11005.029-11.841867*T+7.9337E-20*T**7+GHSERAL; 933.47 Y
  +10481.974-11.253974*T+1.230524E+28*T**(-9)+GHSERAL; 2900.00 N !
FUNCTION GHCPAL 298.15 +5481-1.8*T+GHSERAL; 2900.00 N !
FUNCTION GBCCAL 298.15 +10083-4.813*T+GHSERAL; 2900.00 N !

FUNCTION GHSERVA 298.15 +0; 10000.00 N !

FUNCTION GHSERSI 298.15 0.0; 10000 N !
FUNCTION GLIQSI 298.15 VV0012 + T * VV0013 + GHSERSI; 10000 N !
FUNCTION GFCCSI 298.15 VV0014 + T * VV0015 + GHSERSI; 10000 N !
FUNCTION GDIASI 298.15 GHSERSI; 10000 N !

$------------------------------------------------------------------------------
$ PHASES AND CONSTITUENTS
$------------------------------------------------------------------------------
PHASE LIQUID %  1 1 !
CONSTITUENT LIQUID : AL, SI : !

PHASE FCC_A1 %  2 1 1 !
CONSTITUENT FCC_A1 : AL, SI : VA : !

PHASE DIAMOND_A4 %  2 1 1 !
CONSTITUENT DIAMOND_A4 : AL, SI : VA : !

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$                                     AL                                     $
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
PARAMETER G(LIQUID,AL;0) 1 GLIQAL; 10000 N !
PARAMETER G(FCC_A1,AL:VA;0) 1 GFCCAL; 10000 N !
PARAMETER G(DIAMOND_A4,AL:VA;0) 1 VV0010 + T * VV0011 + GLIQAL; 10000 N !

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$                                     SI                                     $
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
PARAMETER G(LIQUID,SI;0) 1 GLIQSI; 10000 N !
PARAMETER G(FCC_A1,SI:VA;0) 1 GFCCSI; 10000 N !
PARAMETER G(DIAMOND_A4,SI:VA;0) 1 GDIASI; 10000 N !

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$                                   AL-SI                                    $
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
PARAMETER L(LIQUID,AL,SI;0) 1 VV0000 + T * VV0001; 10000 N !
PARAMETER L(LIQUID,AL,SI;1) 1 VV0002 + T * VV0003; 10000 N !
PARAMETER L(LIQUID,AL,SI;2) 1 VV0004 + T * VV0005; 10000 N !
PARAMETER L(FCC_A1,AL,SI:VA;0) 1 VV0006 + T * VV0007; 10000 N !
PARAMETER L(DIAMOND_A4,AL,SI:VA;0) 1 VV0008 + T * VV0009; 10000 N !