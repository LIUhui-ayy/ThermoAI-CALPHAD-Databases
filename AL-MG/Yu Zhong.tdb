$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$

ELEMENT AL FCC_A1 26.982 4577.3 28.322 !
ELEMENT MG HCP_A3 24.305 4998.0 32.671 !
ELEMENT VA VACUUM 0.0 0.0 0.0 !

FUNCTION GFCCAL 298.15 GHSERAL; 2900.0 N !
FUNCTION GFCCMG 298.15 2600-0.9 * T + GHSERMG; 3000.0 N !
FUNCTION GHCPAL 298.15 5481-1.8 * T + GHSERAL; 2900.0 N !
FUNCTION GHCPMG 298.15 GHSERMG; 3000.0 N !
FUNCTION GHSERAL 298.15 -7976.15-8.77664E-07 * T**(3)-0.001884662 * T**(2) +
   74092 * T**(-1) + 137.093038 * T-24.3671976 * T * LOG(T); 700.0 Y
   -11276.24-5.764227E-06 * T**(3) + 0.018531982 * T**(2) + 74092 * T**(-1) +
   223.048446 * T-38.5844296 * T * LOG(T); 933.47 Y -11278.378-1.230524E+28 *
   T**(-9) + 188.684153 * T-31.748192 * T * LOG(T); 2900.0 N !
FUNCTION GHSERMG 298.15 -8367.34-1.393669E-06 * T**(3) + 0.0004858 * T**(2) +
   78950 * T**(-1) + 143.675547 * T-26.1849782 * T * LOG(T); 923.0 Y
   -14130.185 + 1.038192E+28 * T**(-9) + 204.716215 * T-34.3088 * T * LOG(T);
   3000.0 N !
FUNCTION GHSERVA 1 0; 10000 N !
FUNCTION GLIQAL 298.15 11005.029-11.841867 * T + 7.9337E-20 * T**(7) +
   GHSERAL; 700.0 Y 11005.03-11.841867 * T + 7.9337E-20 * T**(7) + GHSERAL;
   933.47 Y -795.996-31.748192 * T * LOG(T) + 177.430178 * T; 2900.0 N !
FUNCTION GLIQMG 298.15 8202.243-8.83693 * T-8.0176E-20 * T**(7) + GHSERMG;
   923.0 Y -5439.869-34.3088 * T * LOG(T) + 195.324057 * T; 3000.0 N !

FUNCTION VV0001 1 -803385.0; 10000 N !
FUNCTION VV0002 1 105.238; 10000 N !
FUNCTION VV0003 1 -170832.0; 10000 N !
FUNCTION VV0004 1 -8.047; 10000 N !
FUNCTION VV0005 1 8360.0; 10000 N !
