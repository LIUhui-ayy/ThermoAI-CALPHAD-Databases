FUNCTION VV0023 1 2.149; 10000 N !
FUNCTION VV0024 1 1014.0; 10000 N !
FUNCTION VV0025 1 -0.660; 10000 N !
FUNCTION VV0026 1 -673.0; 10000 N !
FUNCTION VV0027 1 4336.0; 10000 N !
FUNCTION VV0028 1 -2.863; 10000 N !
FUNCTION VV0029 1 -449.0; 10000 N !
FUNCTION VV0030 1 -0.135; 10000 N !
FUNCTION VV0031 1 -1963.0; 10000 N !

TYPE_DEFINITION % SEQ * !
DEFINE_SYSTEM_DEFAULT ELEMENT 2 !
DEFAULT_COMMAND DEFINE_SYSTEM_ELEMENT VA !

PHASE BETA %  2 140 89 !
CONSTITUENT BETA :AL:MG: !

PHASE EPSILON %  2 30 23 !
CONSTITUENT EPSILON :AL:MG: !

PHASE FCC_A1 %  2 1 1 !
CONSTITUENT FCC_A1 :AL, MG:VA: !

PHASE GAMMA %  3 5 12 12 !
CONSTITUENT GAMMA :MG:AL, MG:AL, MG: !

PHASE HCP_A3 %  2 1 1 !
CONSTITUENT HCP_A3 :AL, MG:VA: !

PHASE LIQUID %  1 1 !
CONSTITUENT LIQUID :AL, MG: !


$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$                                     AL                                     $
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$

PARAMETER G(FCC_A1,AL:VA;0) 1 GFCCAL; 10000 N !
PARAMETER G(HCP_A3,AL:VA;0) 1 GHCPAL; 10000 N !
PARAMETER G(LIQUID,AL;0) 1 GLIQAL; 10000 N !


$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$                                     MG                                     $
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$

PARAMETER G(FCC_A1,MG:VA;0) 1 GFCCMG; 10000 N !
PARAMETER G(HCP_A3,MG:VA;0) 1 GHCPMG; 10000 N !
PARAMETER G(LIQUID,MG;0) 1 GLIQMG; 10000 N !


$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$                                   AL-MG                                    $
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$

PARAMETER G(BETA,AL:MG;0) 1 VV0001 + T * VV0002 + 140 * GHSERAL + 89 * GHSERMG; 10000 N !
PARAMETER G(EPSILON,AL:MG;0) 1 VV0003 + T * VV0004 + 30 * GHSERAL + 23 * GHSERMG; 10000 N !
