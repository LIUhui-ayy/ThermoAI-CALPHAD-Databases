PARAMETER L(GAMMA,MG:MG:AL,MG;0) 1 VV0015 + T * VV0016; 10000 N !
PARAMETER L(HCP_A3,AL,MG:VA;0) 1 VV0027 + T * VV0028; 10000 N !
